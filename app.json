function BottomNav({
  t,
  screen,
  navigate,
}) {
  return (
    <View style={styles.bottomNav}>
      <NavButton
        icon="🏠"
        text={t.home}
        active={screen === 'home'}
        onPress={() =>
          navigate('home')
        }
      />

      <NavButton
        icon="📋"
        text={t.health}
        active={
          screen === 'healthRecord'
        }
        onPress={() =>
          navigate('healthRecord')
        }
      />

      <NavButton
        icon="📍"
        text={t.map}
        active={screen === 'nearby'}
        onPress={() =>
          navigate('nearby')
        }
      />

      <NavButton
        icon="👤"
        text={t.profile}
        active={screen === 'profile'}
        onPress={() =>
          navigate('profile')
        }
      />
    </View>
  );
}

function NavButton({
  icon,
  text,
  active,
  onPress,
}) {
  return (
    <TouchableOpacity
      style={styles.navItem}
      onPress={onPress}
    >
      <Text
        style={[
          styles.navIcon,
          active && styles.navActive,
        ]}
      >
        {icon}
      </Text>

      <Text
        style={[
          styles.navText,
          active && styles.navActive,
        ]}
      >
        {text}
      </Text>
    </TouchableOpacity>
  );
}

