/* ========================= NEARBY ========================= */

function Nearby({
  t,
  lang,
  setLang,
  onBack,
}) {
  const [query, setQuery] = useState('');

  const places = [
    {
      id: '1',
      name: 'Khartoum Teaching Hospital',
      type: 'hospital',
      address: 'Khartoum, Sudan',
      latitude: 15.6002,
      longitude: 32.5308,
    },
    {
      id: '2',
      name: 'Omdurman Hospital',
      type: 'hospital',
      address: 'Omdurman, Sudan',
      latitude: 15.6466,
      longitude: 32.4777,
    },
    {
      id: '3',
      name: 'Nearby Pharmacy',
      type: 'pharmacy',
      address: 'Khartoum, Sudan',
      latitude: 15.505,
      longitude: 32.55,
    },
    {
      id: '4',
      name: 'Health Center',
      type: 'clinic',
      address: 'Khartoum, Sudan',
      latitude: 15.52,
      longitude: 32.57,
    },
  ];

  const filteredPlaces = places.filter(
    (place) =>
      place.name
        .toLowerCase()
        .includes(query.toLowerCase())
  );

  return (
    <View style={styles.app}>
      <Header
        title={t.nearby}
        onBack={onBack}
        lang={lang}
        setLang={setLang}
      />

      <View style={styles.searchBoxMap}>
        <Text>⌕</Text>

        <TextInput
          style={styles.searchInput}
          value={query}
          onChangeText={setQuery}
          placeholder={t.search}
          placeholderTextColor={MUTED}
        />
      </View>

      <View style={styles.mapPlaceholder}>
        <Text style={{ fontSize: 55 }}>
          🗺️
        </Text>

        <Text style={styles.mapPlaceholderTitle}>
          {lang === 'ar'
            ? 'الخريطة'
            : 'Map'}
        </Text>

        <Text style={styles.mapPlaceholderText}>
          {lang === 'ar'
            ? 'يمكنك فتح الموقع والاتجاهات من خلال Google Maps.'
            : 'You can open locations and directions using Google Maps.'}
        </Text>
      </View>

      <FlatList
        data={filteredPlaces}
        keyExtractor={(item) => item.id}
        contentContainerStyle={{
          padding: 15,
          paddingBottom: 30,
        }}
        renderItem={({ item }) => (
          <Card style={styles.placeCard}>
            <View style={styles.placeIcon}>
              <Text style={{ fontSize: 24 }}>
                {item.type === 'pharmacy'
                  ? '💊'
                  : item.type === 'clinic'
                  ? '🏥'
                  : '🏥'}
              </Text>
            </View>

            <View style={{ flex: 1 }}>
              <Text style={styles.placeName}>
                {item.name}
              </Text>

              <Text style={styles.placeType}>
                {item.type === 'pharmacy'
                  ? t.pharmacy
                  : item.type === 'hospital'
                  ? t.hospital
                  : t.clinic}
              </Text>

              <Text style={styles.placeAddress}>
                {item.address}
              </Text>
            </View>

            <TouchableOpacity
              style={styles.directionButton}
              onPress={() =>
                openDirections(
                  item.latitude,
                  item.longitude
                )
              }
            >
              <Text style={styles.directionText}>
                ↗
              </Text>
            </TouchableOpacity>
          </Card>
        )}
      />
    </View>
  );
}

function openDirections(
  latitude,
  longitude
) {
  const url =
    `https://www.google.com/maps/dir/?api=1&destination=${latitude},${longitude}`;

  Linking.openURL(url).catch(() => {});
}

